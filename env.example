# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Exemplo de string de conexão MongoDB Atlas:
# MONGODB_URI=mongodb+srv://admin:password@cluster.lep058a.mongodb.net/crm?retryWrites=true&w=majority&appName=PoraCred

# Para desenvolvimento local, você pode usar:
# MONGODB_URI=mongodb://localhost:27017/crm

# ⚠️ IMPORTANTE: 
# - Nunca commite este arquivo no repositório
# - Use .env.local para desenvolvimento local
# - Configure as variáveis no Vercel para produção 